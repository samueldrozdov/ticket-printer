# Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Frontend Configuration (for Netlify or build step)
# reCAPTCHA Site Key from https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY

# API URL for production (ngrok, Cloudflare tunnel, or direct Raspberry Pi URL)
# Example: https://abc123.ngrok.io or https://your-tunnel.trycloudflare.com
REACT_APP_API_URL=YOUR_API_URL_HERE

# Backend Configuration (for Raspberry Pi)
# Printer connection type: 'usb', 'serial', 'network', 'bluetooth', or 'ble'
PRINTER_TYPE=ble

# BLE Printer Settings (for PRINTER_TYPE=ble)
# Find your printer's MAC address with: bluetoothctl scan on
BLE_PRINTER_ADDR=5A:4A:7B:AE:AE:CA

# BLE Performance Tuning (optional - defaults work well for most printers)
# BLE_IMAGE_CHUNK_SIZE=200       # Bytes per BLE write for images (default: 200)
# BLE_IMAGE_WRITE_GAP_SEC=0.01   # Delay between chunks in seconds (default: 0.01)
# BLE_USE_RESPONSE=true          # Use response-based flow control (default: true, faster)

# Image Processing Settings (optional - tune for your use case)
# IMAGE_MAX_WIDTH=384            # Max width in pixels (384 for 58mm, 576 for 80mm printers)
# IMAGE_MAX_HEIGHT=800           # Max height in pixels (limits print time for tall images)
# IMAGE_USE_DITHERING=true       # Floyd-Steinberg dithering for better detail (default: true)
# IMAGE_CONTRAST=1.5             # Contrast boost factor (1.0 = no change, 1.5 = 50% boost)

# USB Printer Settings (for PRINTER_TYPE=usb)
# Find vendor/product IDs with: lsusb
# Example output: Bus 001 Device 003: ID 0416:5011
USB_VENDOR=0x0416
USB_PRODUCT=0x5011

# Serial/Bluetooth Printer Settings (for PRINTER_TYPE=serial or bluetooth)
SERIAL_PORT=/dev/ttyUSB0

# Network Printer Settings (for PRINTER_TYPE=network)
NETWORK_HOST=192.168.1.100
NETWORK_PORT=9100

# Application Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False
# Bound how long an admitted request waits for hardware. A timed-out operation
# keeps the printer reserved until it exits; other requests stay responsive.
# PRINTER_OPERATION_TIMEOUT=90
# PRINTER_CHECK_TIMEOUT=5

# Password-protected HTTPS access from other networks (see REMOTE_ACCESS.md).
# Generate a password: python -c 'import secrets; print(secrets.token_urlsafe(24))'
# The browser asks only for the password; API Basic auth uses username samson.
# Keep the password only in the Pi's ignored .env file.
# SAMSON_PASSWORD=
# SAMSON_REMOTE_ACCESS=true
# Run python serve_remote.py --tunnel on the Pi for a temporary HTTPS link.

# Optional USB microphone on the Raspberry Pi (see MICROPHONE_SETUP.md)
MICROPHONE_ENABLED=false
MICROPHONE_DEVICE=Samson
# VOSK_MODEL_PATH=/home/your-user/ticket-printer/models/vosk-model-small-en-us-0.15
# Only needed if the frontend uses a different origin from the Pi API:
# MICROPHONE_ALLOWED_ORIGINS=https://your-printer-site.netlify.app

# Netlify Function Configuration
# Convex deployment URL (from Convex dashboard)
# Example: https://your-project.convex.site
CONVEX_DEPLOYMENT=YOUR_CONVEX_DEPLOYMENT_URL
# Print history is enabled automatically. Keep this database across deployments.
# PRINT_HISTORY_PATH=/home/sd/ticket-printer-os/data/print-history.sqlite3
